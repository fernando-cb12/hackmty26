{
  "info": {
    "_postman_id": "e2aa900d-113d-4472-881c-45f485014140",
    "name": "HackMTY 2026 - Caller Detection API",
    "description": "Contract tests for the repository's scripts/example_server.py service. The judge sends one complete stereo WAV as base64 JSON to POST /detect and expects a boolean is_synthetic plus an optional confidence from 0 to 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Returns JSON\", function () {",
          "    pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
          "});",
          "",
          "pm.test(\"Completes within the judge's 30-second limit\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(30001);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "call_id",
      "value": "call_76856257e3ef",
      "type": "string"
    },
    {
      "key": "audio_base64",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Judge-compatible request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const audio = pm.variables.get(\"audio_base64\");",
              "if (!audio) {",
              "    throw new Error(\"audio_base64 is empty. Generate and select the local Postman environment described in postman/README.md.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has the required boolean verdict\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an(\"object\");",
              "    pm.expect(body).to.have.property(\"is_synthetic\");",
              "    pm.expect(body.is_synthetic).to.be.a(\"boolean\");",
              "});",
              "",
              "pm.test(\"Confidence is a number from 0 to 1\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"confidence\");",
              "    pm.expect(body.confidence).to.be.a(\"number\");",
              "    pm.expect(body.confidence).to.be.at.least(0);",
              "    pm.expect(body.confidence).to.be.at.most(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"call_id\": \"{{call_id}}\",\n  \"audio_base64\": \"{{audio_base64}}\",\n  \"sample_rate\": 8000,\n  \"channels\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/detect",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "detect"
          ]
        },
        "description": "Matches scripts/check_endpoint.py exactly: complete WAV bytes encoded as base64 inside a JSON object."
      },
      "response": []
    },
    {
      "name": "Protocol rejection tests",
